{
  "name": "agent-card-codecard-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "validate:dependencies": "node scripts/validate-dependencies.mjs",
    "test:audit": "node --test scripts/audit-dependencies.test.mjs",
    "test": "vitest run --passWithNoTests",
    "build": "vite build",
    "validate:bundle": "node scripts/validate-bundle.mjs",
    "verify": "pnpm run validate:dependencies && pnpm run test:audit && pnpm run typecheck && pnpm test && pnpm run build && pnpm run validate:bundle"
  },
  "dependencies": {
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.5",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}
