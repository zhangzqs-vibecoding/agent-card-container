AGENTCARD_MODE=all
AGENTCARD_ADDR=:8080

# Development-only bearer authentication. Leave empty in production.
AGENTCARD_DEV_TOKEN=
AGENTCARD_DEV_USER=

# Production OIDC authentication.
AGENTCARD_OIDC_ISSUER=
AGENTCARD_OIDC_AUDIENCE=
AGENTCARD_OIDC_JWKS_URL=

# OpenAI-compatible model provider (for example DeepSeek).
AGENTCARD_MODEL_BASE_URL=https://api.deepseek.com
AGENTCARD_MODEL=
AGENTCARD_MODEL_API_KEY=
AGENTCARD_MODEL_ALLOW_INSECURE=false

# Production persistence. Configure PostgreSQL and S3 together. Leave both
# endpoint variables empty only for the single-process in-memory development mode.
# Set this to true in every remote or shared environment to prevent an accidental
# fallback to process-local memory repositories.
AGENTCARD_PERSISTENCE_REQUIRED=false
AGENTCARD_DATABASE_URL=
AGENTCARD_S3_ENDPOINT=
AGENTCARD_S3_ACCESS_KEY=
AGENTCARD_S3_SECRET_KEY=
AGENTCARD_S3_BUCKET=
AGENTCARD_S3_REGION=us-east-1
AGENTCARD_S3_SECURE=true

# Ed25519 key ID and base64 seed/private key. Use a managed signer in production.
AGENTCARD_SIGNING_KEY_ID=
AGENTCARD_SIGNING_PRIVATE_KEY=

# Required only for CodeCard generation.
AGENTCARD_SANDBOX_IMAGE=
AGENTCARD_CODECARD_TEMPLATE=
AGENTCARD_DOCKER_BINARY=docker

# Enables the paid, opt-in live model test.
AGENTCARD_DEEPSEEK_LIVE=0
